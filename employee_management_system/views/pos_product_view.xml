<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_product_pos_inherit" model="ir.ui.view">
        <field name="name">product.product.pos.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="point_of_sale.product_product_view_form_normalized_pos"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="pos_description"/>
            </xpath>
        </field>
    </record>
</odoo>
