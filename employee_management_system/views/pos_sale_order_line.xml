<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_order_form_inherit_slice_you_got" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.slice.you.got</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']//list/field[@name='tax_id']" position="after">
        <field name="slice_you_got" string="Slices"/>
      </xpath>
    </field>
  </record>
</odoo>
