<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <t t-name="employee_management_system.product_list_template">
    <div class="o_product_list" style="margin-top:15px;">
      <table class="table table-sm table-bordered">
        <thead>
          <tr>
            <th>Product</th>
            <th>Quantity</th>
          </tr>
        </thead>
        <tbody>
          <t t-foreach="products" t-as="line">
            <tr>
              <td><t t-esc="line['product_id'][1]"/></td>
              <td><t t-esc="line['product_uom_qty']"/></td>
            </tr>
          </t>
        </tbody>
      </table>
    </div>
  </t>
</odoo>
