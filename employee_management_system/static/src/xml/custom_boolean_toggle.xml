<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="employee_management_system.CustomBooleanToggleTemplate" owl="1">
        <label style="position:relative; display:inline-block; width:40px; height:22px;">
            <input type="checkbox"
                   t-att-checked="props.value"
                   t-on-change="onChange"
                   style="opacity:0; width:0; height:0;"/>
            <span style="
                position:absolute; cursor:pointer; top:0; left:0; right:0; bottom:0;
                background-color:#ccc; border-radius:22px; transition:0.3s;">
                <span style="
                    position:absolute; content:''; height:16px; width:16px; left:3px; bottom:3px;
                    background-color:white; border-radius:50%; transition:0.3s;"
                    t-att-style="'left:' + (props.value ? '18px' : '3px') + ';'"/>
            </span>
        </label>
    </t>
</templates>

CustomBooleanToggle.template = "employee_management_system.CustomBooleanToggleTemplate";