<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="employee_management_system.ListView"
       t-inherit="web.ListView"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//div[@class='o_control_panel_main_buttons]' position="after">
            <button type="button" class="btn btn-primary"
                    t-on-click="handleImportClick">
                Import Data
            </button>
        </xpath>
    </t>
</templates>

