<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emp_employee_manager_rule" model="ir.rule">
        <field name="name">Employee Manager</field>
        <field name="model_id" ref="model_emp_employee"/>
        <field name="groups" eval="[(4, ref('employee_management_system.group_employee_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="emp_employee_user_rule" model="ir.rule">
        <field name="name">Employee User</field>
        <field name="model_id" ref="model_emp_employee"/>
        <field name="groups" eval="[(4, ref('employee_management_system.group_employee_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_employee_assigned_admin_only" model="ir.rule">
        <field name="name">Employee Access: Only Assigned Employees</field>
        <field name="model_id" ref="employee_management_system.model_emp_employee"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
