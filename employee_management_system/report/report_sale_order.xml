<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_saleorder_document_custom" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table" position="after">
            <h3>Custom Order Lines</h3>
            <table class="table table-condensed">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Description</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Taxes</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.custom_order_line_ids" t-as="line">
                        <tr>
                            <td><span t-field="line.product_id"/></td>
                            <td><span t-field="line.name"/></td>
                            <td><span t-field="line.product_uom_qty"/></td>
                            <td><span t-field="line.price_unit"/></td>
                            <td>
                                <t t-foreach="line.tax_id" t-as="tax">
                                    <span t-field="tax.name"/>
                                    <t t-if="not loop.last">, </t>
                                </t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
